# Postgres connection string. Local dev uses `prisma dev`'s local
# prisma+postgres:// URL; production points at the real database
# (Neon/Supabase) — use its pooled/serverless-friendly connection string.
DATABASE_URL=postgresql://user:password@host:5432/orbit?sslmode=require

# Secret used to sign/verify JWTs (server/src/utils/jwt.ts). Required —
# the server throws on startup if unset. Use a long, random value in
# production; never reuse the local dev value.
JWT_SECRET=replace-with-a-long-random-secret

# Origin of the deployed frontend — used for CORS (server/src/app.ts)
# and to build password-reset links (auth.controller.ts). Falls back to
# http://localhost:5173 when unset, so this must be set explicitly in
# production.
FRONTEND_URL=https://your-frontend.vercel.app

# Real password-reset email delivery (server/src/services/email.service.ts)
# via SMTP. EMAIL_SMTP_USER/EMAIL_SMTP_PASSWORD are placeholders — a Gmail
# App Password (not the account login password) works for EMAIL_SMTP_HOST=
# smtp.gmail.com.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=your-smtp-user@example.com
EMAIL_SMTP_PASSWORD=replace-with-smtp-app-password
EMAIL_FROM=ORBIT <no-reply@example.com>

# Render assigns this automatically at runtime — no need to set it
# yourself. Local dev falls back to 5000 when unset (server/src/index.ts).
# PORT=5000
